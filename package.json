{
  "name": "defuss-midi-synth",
  "version": "0.4.0",
  "description": "General MIDI and optional vintage hardware synthesis profiles for WebAssembly and AudioWorklet",
  "keywords": [
    "midi",
    "general-midi",
    "soundfont",
    "sf2",
    "opl3",
    "fm-synthesis",
    "adlib",
    "synthesizer",
    "audioworklet",
    "webassembly",
    "web-audio"
  ],
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Aron Homberg",
  "packageManager": "bun@1.4.3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./offline": {
      "types": "./dist/offline.d.ts",
      "import": "./dist/offline.js"
    }
  },
  "files": [
    "dist",
    "src",
    "native",
    "README.md",
    "ARCH.md",
    "CHANGELOG.md",
    "VALIDATION.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "HARDWARE_PROFILES.md",
    "scripts/build-native-profiles.py",
    "scripts/build-vintage-wasm.py",
    "vendor/sources/munt-mt32emu-f5b968c4.tar.gz",
    "vendor/sources/86box-cqm-141ae59c.tar.gz"
  ],
  "scripts": {
    "build": "node scripts/build.mjs --prepare && pkgroll && node scripts/build.mjs --finish",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts demo docs/app.js docs/player.js docs/profile-files.js && tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "coverage": "node scripts/coverage.mjs",
    "e2e": "node scripts/e2e.mjs",
    "bench": "node --experimental-transform-types --no-warnings scripts/bench.mjs",
    "dev": "node scripts/serve.mjs",
    "verify": "make verify",
    "compress": "node scripts/compress-banks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "butterchurn-presets": "2.4.7",
    "defuss-brotli": "0.4.0",
    "defuss-shadcn": "0.10.0",
    "defuss-storage": "0.4.1",
    "esbuild": "0.25.12",
    "oxlint": "1.26.0",
    "pkgroll": "2.29.1",
    "typescript": "5.9.3"
  }
}
